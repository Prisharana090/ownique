# Copy this file to .env.local and fill in your keys
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ownique
XAI_API_KEY=
GROK_MODEL=grok-4.7
GEMINI_API_KEY=
TIGER_DATABASE_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
VAULT_SECRET_KEY=
# Your site's public address (used in NFT metadata). Change to your domain after deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Gemini model names (change if Google renames them)
GEMINI_MODEL=gemini-3.5-flash
# (optional) your Phantom address, so sample designs are yours
SEED_DESIGNER_WALLET=
# Capital One Nessie (practice banking API) for "Pay with bank"
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
SOL_USD_RATE=150

# Optional AI Try-On. Gemini image models are billed (no free tier): set AI_PREVIEW_PROVIDER=gemini only after enabling billing.
AI_PREVIEW_PROVIDER=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Or Cloudflare Workers AI (FLUX.2 klein 4B). Token needs Workers AI permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
AI_PREVIEW_DAILY_CAP=20
